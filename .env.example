# Copy to .env, then replace the two local secrets before running Compose.
APP_MODE=demo
APP_SECRET_KEY=replace-with-a-random-32-character-or-longer-value
POSTGRES_PASSWORD=replace-with-a-unique-local-db-password
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
DEMO_DATA_SIZE=full
DEMO_SEED=20260927
DEMO_REFERENCE_DATE=2026-09-27
RETENTION_DAYS=90
AUDIO_RETENTION_ENABLED=false

# Connected mode is explicit. Blank credentials never produce simulated success.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-live-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
CALENDAR_PROVIDER=local
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional, disabled by default so source content is not sent to tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=voicedesk

